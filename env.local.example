# Local lesson services. Copy to .env.local and replace the placeholders.
# This example file contains no usable credentials.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

WHITEBOPHIR_URL=http://localhost:5001
WHITEBOPHIR_AUTH_SECRET=replace-with-output-of-openssl-rand-hex-32
WHITEBOPHIR_VERSION=latest

# Browser-facing Jitsi host and server-side JWT signing config.
JITSI_DOMAIN=localhost:8000
JITSI_APP_ID=tutorplace-local
JITSI_APP_SECRET=replace-with-the-same-secret-configured-in-local-jitsi
ASSIGNMENT_IMAGE_DIRECTORY=.data/assignment-images
